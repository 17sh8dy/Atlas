{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "1.0.1",
  "identifier": "dev.atlas.assistant",
  "build": {
    "beforeDevCommand": "pnpm --filter @atlas/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @atlas/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas",
        "width": 820,
        "height": 620,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://nova-help.17sh8dy.workers.dev; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A local-first desktop assistant",
    "longDescription": "Atlas understands what you ask, drives your machine, and keeps everything on it. External models are optional.",
    "resources": {
      "vendor/piper/piper": "vendor/piper/piper",
      "vendor/piper/en_GB-vctk-medium.onnx": "vendor/piper/en_GB-vctk-medium.onnx",
      "vendor/piper/en_GB-vctk-medium.onnx.json": "vendor/piper/en_GB-vctk-medium.onnx.json",
      "vendor/whisper/whisper-cli.exe": "vendor/whisper/whisper-cli.exe",
      "vendor/whisper/ggml-base.en.bin": "vendor/whisper/ggml-base.en.bin",
      "vendor/whisper/whisper.dll": "vendor/whisper/whisper.dll",
      "vendor/whisper/ggml.dll": "vendor/whisper/ggml.dll",
      "vendor/whisper/ggml-base.dll": "vendor/whisper/ggml-base.dll",
      "vendor/whisper/ggml-cpu-*.dll": "vendor/whisper/",
      "vendor/kokoro/kokoro.onnx": "vendor/kokoro/kokoro.onnx",
      "vendor/kokoro/onnxruntime.dll": "vendor/kokoro/onnxruntime.dll",
      "vendor/kokoro/voices/*.bin": "vendor/kokoro/voices/"
    }
  }
}
