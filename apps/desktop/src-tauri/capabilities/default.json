{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Atlas window is permitted to do. Tauri 2 denies everything not listed here, so this file is the allow-list — deliberately short, and deliberately without any shell or arbitrary-fs permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-current-monitor",
    "core:window:allow-outer-position",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:event:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "global-shortcut:default",
    "notification:default"
  ]
}
